# Шаблон настроек. Скопируйте в .env и поменяйте значения: cp .env.example .env
# Файл .env в git не попадает.

# Используются docker-compose при создании контейнера с базой
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me
POSTGRES_DB=library

# Используется приложением, Alembic и тестами (пароль должен совпадать с POSTGRES_PASSWORD).
# Тесты сами берут из этого адреса отдельную базу <имя>_test.
DATABASE_URL=postgresql+psycopg://library:change-me@127.0.0.1:5432/library

# Redis (кэш и «популярные книги»). Необязательно: без этой переменной приложение работает без кэша.
# Запуск: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379/0

# Secret that signs login tokens (JWT). REQUIRED: the application refuses to start without it.
# At least 32 bytes. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real value. Changing it logs everybody out.
JWT_SECRET=

# Demo accounts with PUBLIC passwords (admin / librarian / reader): see the README. `true` makes the API warn at startup and
# allows `python -m app.cli seed-demo`. Local machine only: never enable it where other people can reach the application.
DEMO_ACCOUNTS=false
