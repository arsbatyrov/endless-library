{
  "components": {
    "schemas": {
      "BookCreate": {
        "description": "Что клиент присылает при создании книги (без id).\n\nstrict: типы не приводятся «по-дружески». Иначе false принималось бы как число 0, а \"5\" как 5;\nтакие запросы нарушают контракт, и их нужно отклонять (это нашёл Schemathesis).\nИсключение сделано сознательно: целое число вида 5.0 допустимо по спецификации JSON Schema (см. _json_integer).",
        "properties": {
          "author": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "title": "Author",
            "type": "string"
          },
          "copies_available": {
            "default": 1,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Copies Available",
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "title": "Title",
            "type": "string"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "required": [
          "title",
          "author"
        ],
        "title": "BookCreate",
        "type": "object"
      },
      "BookRead": {
        "description": "Что мы отдаём в ответе (с id).",
        "properties": {
          "author": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "title": "Author",
            "type": "string"
          },
          "copies_available": {
            "default": 1,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Copies Available",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\u0000]*$",
            "title": "Title",
            "type": "string"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "required": [
          "title",
          "author",
          "id"
        ],
        "title": "BookRead",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Тело ошибки 404/409: причина строкой.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
