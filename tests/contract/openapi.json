            "maxLength": 200,
            "pattern": "^[^@ \\t\\r\\n\\f\\v\\u0000]+@[^@ \\t\\r\\n\\f\\v\\u0000]+\\.[^@ \\t\\r\\n\\f\\v\\u0000]+$",
            "title": "Email",
