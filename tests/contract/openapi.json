              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoanCreate": {
        "properties": {
          "book_id": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Book Id",
            "type": "integer"
          },
          "reader_id": {
